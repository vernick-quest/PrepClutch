// Builds lib/geo-cities.ts from the curated list (cities-curation.mts) and
// the Wikidata snapshot (cities-snapshot.json, CC0). Run:
//
//   node supabase/geography/build-cities.mts
//   node supabase/geography/validate-cities.mts
//
// Refuses to write when a curated fact disagrees with Wikidata without a
// written reason in CITY_REASONS, or when a reason explains nothing:
//   - the city's country must be a CURRENT Wikidata country (P17) of the
//     pinned item, and no other UN member may be one without a reason
//   - our kid-friendly name must match Wikidata's English label (accents
//     and case aside), or have a reason
//   - coordinates and population must exist
// Chosen from Wikidata: coordinates = the preferred-rank value, else the
// first normal one (values differ by well under a kilometre); population =
// the preferred-rank value, else the most recent by point in time (P585).
// Coordinates are rounded to 2 decimal places (about 1 km), like capitals.

import './ts-resolve.mts'
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { CITY_ROWS, CITY_REASONS, COUNTRY_ITEMS } from './cities-curation.mts'
import { normName } from './normalize.mts'

const here = path.dirname(fileURLToPath(import.meta.url))
const root = path.resolve(here, '../..')
const { COUNTRIES } = await import('../../lib/geo-data.ts')

interface SnapRow {
  item: string; label: string
  countries: { item: string; iso: string; current: boolean }[]
  coords: { lat: number; lon: number; rank: string }[]
  population: { n: number; date: string; rank: string }[]
}
const snap = JSON.parse(fs.readFileSync(path.join(here, 'cities-snapshot.json'), 'utf8')) as
  { source: string; fetched: string; rows: SnapRow[] }
const byItem = new Map(snap.rows.map(r => [r.item, r]))
const byIso = new Map(COUNTRIES.map(c => [c.iso, c]))
const UN = new Set(COUNTRIES.map(c => c.iso))

const problems: string[] = []
const used = new Set<string>()
function differs(key: string, what: string) {
  if (CITY_REASONS[key]) used.add(key)
  else problems.push(`${key}: ${what}, and no entry in CITY_REASONS`)
}
const round = (n: number) => Math.round(n * 100) / 100
export const slug = (name: string) => normName(name).replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')

const cities = CITY_ROWS.map(([name, iso, tier, qid, notWrong]) => {
  const w = byItem.get(qid)
  const c = byIso.get(iso)
  if (!c) { problems.push(`${name}: ${iso} is not a UN member in lib/geo-data.ts`); return null }
  if (!w) { problems.push(`${name}: ${qid} is not in the snapshot (run fetch-cities.mts)`); return null }

  if (normName(w.label) !== normName(name)) differs(`${qid}:name`, `we say ${name}, Wikidata says ${w.label}`)

  const mine = new Set([c.wikidata, ...(COUNTRY_ITEMS[iso] ?? [])])
  const current = w.countries.filter(x => x.current)
  if (!current.some(x => mine.has(x.item))) problems.push(`${name} (${qid}): ${c.name} is not a current Wikidata country (${current.map(x => x.item).join(' ') || 'none'})`)
  for (const x of current) {
    if (!mine.has(x.item) && UN.has(x.iso) && x.iso !== iso) differs(`${qid}:P17:${x.iso}`, `Wikidata also gives ${x.iso} as a current country`)
  }

  const coord = w.coords.find(x => x.rank === 'preferred') ?? w.coords[0]
  if (!coord) problems.push(`${name} (${qid}): no coordinates`)
  const pref = w.population.filter(x => x.rank === 'preferred')
  const pop = (pref.length ? pref : w.population).slice().sort((a, b) => a.date.localeCompare(b.date) || a.n - b.n).at(-1)
  if (!pop || !(pop.n > 0)) problems.push(`${name} (${qid}): no population`)
  for (const x of notWrong ?? []) if (!UN.has(x) || x === iso) problems.push(`${name}: notWrong ${x} is not another UN member`)

  return {
    id: slug(name), name, iso, continent: c.continent, tier,
    lat: round(coord?.lat ?? NaN), lon: round(coord?.lon ?? NaN),
    population: Math.round(pop?.n ?? 0), popYear: pop?.date.slice(0, 4) || undefined,
    wikidata: qid,
    ...(notWrong?.length ? { notWrong } : {}),
  }
})
for (const k of Object.keys(CITY_REASONS)) if (!used.has(k)) problems.push(`CITY_REASONS['${k}'] explains nothing: remove it`)

if (problems.length) {
  console.error(`Refusing to write lib/geo-cities.ts, ${problems.length} problem(s):`)
  problems.forEach(p => console.error('  ' + p))
  process.exit(1)
}
const list = cities.filter(c => c !== null)

const out = `// ── Geography data: famous world cities (not capitals) ───────────────────────
//
// GENERATED by supabase/geography/build-cities.mts. Do not edit by hand:
// change supabase/geography/cities-curation.mts, then run
//   node supabase/geography/fetch-cities.mts     (only when the list changes)
//   node supabase/geography/build-cities.mts
//   node supabase/geography/validate-cities.mts
//
// Source: ${snap.source}, fetched ${snap.fetched}.
// Wikidata is CC0, so this file can be bundled freely. Every curated value
// that differs from Wikidata has a written reason in cities-curation.mts.
// Nothing here comes from GeoNames (CC BY) or OpenStreetMap (ODbL).
//
// ${list.length} cities. Chosen and tiered by hand for kids of about 8 to 14
// (tier 1 = everyone has heard of it, 3 = famous but a stretch); the hard
// cases (Hong Kong, Istanbul, left-out capitals, same-named places) are
// written up in cities-curation.mts. None is a capital in lib/geo-data.ts,
// and each one's coordinates (Wikidata P625, 2 decimal places) lie in its
// own country on the Natural Earth map: validate-cities.mts checks both.
//
// SERVER ONLY in practice: import it from lib/geo.ts, never from a client
// component (pages pass the few fields a component needs).
// No '@/' imports, so Node can run this file for the generators and checks.

import type { Continent } from './geo-data'

export interface City {
  /** URL-safe id: card key "city:<id>", pin place key "city:<id>". */
  id:          string
  name:        string
  /** ISO alpha-2 of its UN member country (lib/geo-data.ts). */
  iso:         string
  /** Its country's continent. */
  continent:   Continent
  /** Fame: 1 = everyone has heard of it, 3 = famous but a stretch. */
  tier:        1 | 2 | 3
  lat:         number
  lon:         number
  /** Wikidata P1082, for reference (not asked). */
  population:  number
  popYear?:    string
  wikidata:    string
  /** Countries never offered as a wrong answer on this city's card. */
  notWrong?:   string[]
}

export const CITIES: City[] = [
${list.map(c => '  ' + JSON.stringify(c)).join(',\n')},
]
`
fs.writeFileSync(path.join(root, 'lib/geo-cities.ts'), out)
console.log(`wrote lib/geo-cities.ts: ${list.length} cities, ${Object.keys(CITY_REASONS).length} reasoned differences from Wikidata`)
